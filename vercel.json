{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/|Image/|assets/|admin\\.html|style\\.css|script\\.js|gsap\\.min\\.js|music\\.mp3|guests\\.json|wishes\\.json|robots\\.txt|llms\\.txt|sitemap\\.xml|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
